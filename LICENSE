  ('Bank of Botswana', 'Bank of Botswana', 'https://www.bankofbotswana.bw', 'government'),
  ('IFC', 'International Finance Corporation', 'https://www.ifc.org', 'international'),
  ('Bokra', 'Bokra.co.bw', 'https://bokra.co.bw', 'market'),
  ('SAGEWORKS Field', 'SAGEWORKS AI Field Data', 'https://github.com/PeacebinfLow', 'sme');

