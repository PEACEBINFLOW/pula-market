
### FILE 4: `supabase-schema.sql`

```sql
-- ═══════════════════════════════════════════════════
-- PULA MARKET · SAGEWORKS AI
-- Supabase Database Schema
-- Run this in SQL Editor:
-- https://sjladuwbjctoxeuxcfmg.supabase.co
-- ═══════════════════════════════════════════════════

-- Articles / Intelligence Feed
CREATE TABLE IF NOT EXISTS articles (
  id          UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  created_at  TIMESTAMPTZ DEFAULT NOW(),
  updated_at  TIMESTAMPTZ DEFAULT NOW(),
  title       TEXT NOT NULL,
  excerpt     TEXT,
  body        TEXT,
  tag         TEXT,
  sector      TEXT,
  source_name TEXT NOT NULL,
  source_url  TEXT,
  source_date DATE,
  featured    BOOLEAN DEFAULT FALSE,
  published   BOOLEAN DEFAULT TRUE
);
ALTER TABLE articles ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public read articles" ON articles FOR SELECT USING (published = TRUE);

-- Market Data
CREATE TABLE IF NOT EXISTS market_data (
  id           UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  created_at   TIMESTAMPTZ DEFAULT NOW(),
  ticker       TEXT NOT NULL,
  company_name TEXT NOT NULL,
  sector       TEXT,
  price        NUMERIC(12,4),
  change_pct   NUMERIC(6,2),
  volume       BIGINT,
  market_cap   TEXT,
  data_date    DATE NOT NULL,
  source_url   TEXT DEFAULT 'https://www.bse.co.bw'
);
ALTER TABLE market_data ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public read market_data" ON market_data FOR SELECT USING (TRUE);

-- SME Daily Log
CREATE TABLE IF NOT EXISTS sme_daily_log (
  id            UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  log_date      DATE NOT NULL DEFAULT CURRENT_DATE,
  business_name TEXT NOT NULL,
  units_sold    INTEGER,
  unit_price    NUMERIC(8,2),
  revenue       NUMERIC(10,2),
  cogs          NUMERIC(10,2),
  profit        NUMERIC(10,2),
  notes         TEXT,
  district      TEXT DEFAULT 'Ngami',
  town          TEXT DEFAULT 'Maun'
);
ALTER TABLE sme_daily_log ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public read sme_daily_log" ON sme_daily_log FOR SELECT USING (TRUE);

-- Data Sources Registry
CREATE TABLE IF NOT EXISTS data_sources (
  id           UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  name         TEXT NOT NULL,
  full_name    TEXT,
  url          TEXT,
  category     TEXT,
  active       BOOLEAN DEFAULT TRUE,
  last_checked DATE
);
ALTER TABLE data_sources ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public read data_sources" ON data_sources FOR SELECT USING (TRUE);

-- Companies Directory
CREATE TABLE IF NOT EXISTS companies (
  id          UUID DEFAULT gen_random_uuid() PRIMARY KEY,
  created_at  TIMESTAMPTZ DEFAULT NOW(),
  name        TEXT NOT NULL,
  ticker      TEXT,
  sector      TEXT,
  district    TEXT,
  listed      BOOLEAN DEFAULT FALSE,
  description TEXT,
  source_url  TEXT
);
ALTER TABLE companies ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Public read companies" ON companies FOR SELECT USING (TRUE);

-- Seed Data: Sources
INSERT INTO data_sources (name, full_name, url, category) VALUES
  ('BSE', 'Botswana Stock Exchange', 'https://www.bse.co.bw', 'market'),
